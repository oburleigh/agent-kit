{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "bootstrap-sha": "a3423d74169d6b1f497399b9cc2a33783800d697",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "separate-pull-requests": false,
  "always-update": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "group-pull-request-title-pattern": "chore(release): release ${branch}",
  "pull-request-title-pattern": "chore(release): release ${component} ${version}",
  "packages": {
    ".": {
      "component": "agent-kit",
      "release-type": "simple",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/create-skill": {
      "component": "create-skill",
      "release-type": "simple",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/git-commit": {
      "component": "git-commit",
      "release-type": "simple",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/humanize": {
      "component": "humanize",
      "release-type": "simple",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".codex-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "plugins/python-scaffold": {
      "component": "python-scaffold",
      "release-type": "simple",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
