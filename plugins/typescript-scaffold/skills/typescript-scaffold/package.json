  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/semver": "^7.8.0",
    "@types/validate-npm-package-name": "^4.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
